// Writes docs/starter-review.md: every Starter phrase in one table, for skimming the translations.
// Pass language codes to get a narrower table in its own file: `npm run starter:review -- es,en,fr`.
import { writeFileSync } from "node:fs";
import { starter } from "../src/shared/bundles/starter/index";
import { LANG_CODES, type Lang } from "../src/shared/languages";

const requested = process.argv[2]?.split(",") ?? [];
const unknown = requested.filter((l) => !LANG_CODES.includes(l as Lang));
if (unknown.length > 0)
  throw new Error(`Unknown language: ${unknown.join(", ")}`);
const langs = requested.length > 0 ? (requested as Lang[]) : [...LANG_CODES];
const file =
  requested.length > 0
    ? `docs/starter-review-${requested.join("-")}.md`
    : "docs/starter-review.md";

const cell = (text: string) => text.replaceAll("|", "\\|");
const header = ["id", "topic", "src", ...langs];
const rows = starter.phrases.map((p) => [
  p.id,
  p.topic,
  p.source,
  ...langs.map((l) => cell(p.text[l])),
]);
const table = [header, header.map(() => "---"), ...rows]
  .map((r) => `| ${r.join(" | ")} |`)
  .join("\n");

writeFileSync(
  file,
  `# Starter phrases: review table\n\nGenerated by \`npm run starter:review\` from \`src/shared/bundles/starter/\`. Fix a phrase in the data, then run it again.\n\n${table}\n`,
);
console.log(`Wrote ${rows.length} phrases to ${file}`);
